# Copy to .env.local and fill in. These are all safe to be client-side —
# Vite bundles anything prefixed VITE_ into the shipped JS, so nothing
# secret belongs in this file. API keys for Pl@ntNet and the AI seed-plan
# lookup live server-side as Supabase Edge Function secrets instead — see
# supabase/functions/*/index.ts and README notes there for how to set them.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — falls back to a browser location prompt if unset.
VITE_GARDEN_LAT=
VITE_GARDEN_LON=

# Which Pl@ntNet taxonomic project to query. Not a secret.
VITE_PLANTNET_PROJECT=all

VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1
